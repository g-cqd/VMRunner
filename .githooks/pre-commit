#!/bin/bash
# Fast pre-commit checks on the staged Swift and shell files only: swift-format lint, SwiftLint, ShellCheck.
# The full gate (build, tests, analyzers, sanitizers, coverage) is Scripts/check.sh; CI runs it too.
# Install with Scripts/install-hooks.sh. Bypass in an emergency with `git commit --no-verify`.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

swift_files=()
shell_files=()
while IFS= read -r -d '' file; do
    case "$file" in
        *.swift) swift_files+=("$file") ;;
        Scripts/*.sh | .githooks/*) shell_files+=("$file") ;;
        *) ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

failed=0

if [ "${#swift_files[@]}" -gt 0 ]; then
    swift_format="$(command -v swift-format || xcrun --find swift-format)"
    echo "pre-commit: swift-format lint (${#swift_files[@]} file(s))"
    "$swift_format" lint --strict "${swift_files[@]}" || failed=1

    if command -v swiftlint >/dev/null 2>&1; then
        echo "pre-commit: swiftlint (${#swift_files[@]} file(s))"
        swiftlint lint --quiet --force-exclude "${swift_files[@]}" || failed=1
    else
        echo "pre-commit: swiftlint not installed (brew install swiftlint)" >&2
        failed=1
    fi
fi

if [ "${#shell_files[@]}" -gt 0 ]; then
    if command -v shellcheck >/dev/null 2>&1; then
        echo "pre-commit: shellcheck (${#shell_files[@]} file(s))"
        shellcheck -x "${shell_files[@]}" || failed=1
    else
        echo "pre-commit: shellcheck not installed (brew install shellcheck)" >&2
        failed=1
    fi
fi

if [ "$failed" -ne 0 ]; then
    echo "pre-commit: checks failed; fix the findings above or run Scripts/check.sh for the full picture" >&2
    exit 1
fi
