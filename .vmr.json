{
  "lintPaths": ["Sources", "Plugins", "Tests", "Packages/Containers/Sources", "Packages/Containers/Tests", "Packages/VirtioGPU/Sources", "Packages/VirtioGPU/Tests"],
  "packages": ["Packages/Containers", "Packages/VirtioGPU"],
  "skipTestsWhenInstrumented": ["DevToolsTests"],
  "coverage": {
    "minimum": 55,
    "testBundles": ["VMRunnerTests", "NetPolicyTests", "NetStackTests", "GuestSeedTests", "ControlProtocolTests", "AgentBridgeTests"],
    "ignoreRegex": "Tests/|\\.build|/Views/|VMRunnerApp|VMController|Provisioner|ConfigurationBuilder"
  }
}
