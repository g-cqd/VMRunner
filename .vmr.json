{
  "lintPaths": ["Sources", "Plugins", "Tests", "Packages/Containers/Sources", "Packages/Containers/Tests"],
  "packages": ["Packages/Containers"],
  "skipTestsWhenInstrumented": ["DevToolsTests"],
  "coverage": {
    "minimum": 55,
    "testBundles": ["VMRunnerTests", "NetPolicyTests", "NetStackTests", "ProvisioningTests"],
    "ignoreRegex": "Tests/|\\.build|/Views/|VMRunnerApp|VMController|Provisioner|ConfigurationBuilder"
  }
}
